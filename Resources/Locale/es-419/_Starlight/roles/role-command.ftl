command-description-role-setjob =
    Cambia el trabajo de la entidad recibida por pipe.
command-description-role-rmjob =
    Quita el trabajo de la entidad recibida por pipe, si tiene uno.
command-description-role-rmsetjob =
    Cambia el trabajo de la entidad recibida por pipe borrándolo y luego asignándolo, para que se reproduzca la presentación.
command-description-role-dobriefing =
    Fuerza a que la presentación del rol se reproduzca de nuevo para la entidad recibida por pipe.
command-description-role-setroletype =
    Establece el tipo de rol principal para la mente de la entidad recibida por pipe.
command-description-role-addrole =
    Agrega un rol a la mente de la entidad recibida por pipe, a menos que ya exista.
command-description-role-rmrole =
    Quita un rol de la mente de la entidad recibida por pipe.
command-description-role-doroleupdate =
    Fuerza a que el mensaje de actualización del tipo de rol se reproduzca de nuevo para la entidad recibida por pipe.
command-description-role-has =
    Devuelve true o false según si la entidad recibida por pipe tiene el rol especificado.
command-description-role-with =
    Filtra la lista de entidades recibida por pipe según si tienen el rol especificado.
command-description-role-hasjob =
    Devuelve true o false según si la entidad recibida por pipe tiene el trabajo especificado.
command-description-role-withjob =
    Filtra la lista de entidades recibida por pipe según si tienen el trabajo especificado.
