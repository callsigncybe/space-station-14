devil-role-briefing =
    Eres un demonio, un agente infernal
    enviado desde las profundidades de los nueve infiernos
    para llevar a la tripulación de esta estación a una vida de pecado.
    Haz tratos con los tripulantes y, por contrato,
    obtén sus almas a cambio de cumplir sus
    caprichosos deseos materiales.

    Recuerda: la tripulación puede usar tu verdadero nombre en tu contra.

objective-issuer-devil = [color=#d90b0b]8.ª Oficina de Recuperación de Almas, División de Campo[/color]

devil-round-end-agent-name = demonio
