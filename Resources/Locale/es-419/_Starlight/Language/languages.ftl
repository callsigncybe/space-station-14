language-chat-confirmation = El mensaje se enviará en {$lang}.

language-Universal-name = Universal
language-Universal-description = ¿Qué eres?

language-GalacticCommon-name = Común Galáctico
language-GalacticCommon-description = La lengua galáctica común, diseñada para la comunicación entre especies. ¡Todo viajero espacial la conoce!

language-Sign-name = Lengua de señas galáctica
language-Sign-description = Una lengua de señas usada comúnmente por personas sordas o mudas. Es especialmente popular entre los viajeros espaciales por su practicidad en entornos sin aire.

language-ClassicalSign-name = Lengua de señas clásica
language-ClassicalSign-description = Una lengua de señas más antigua y desconocida originaria de Terra. Es completamente distinta de la lengua de señas galáctica.

language-SolCommon-name = Común Sol
language-SolCommon-description = Una lengua artificial diseñada por la Federación Transolar para facilitar el uso y la comunicación concisa.

language-CygniStandard-name = Estándar Cygni
language-CygniStandard-description = Una lengua artificial diseñada para recordarles a sus hablantes el Pacto de Varsovia, con poca precisión. Se habla ampliamente en la USSP, junto con el Común Galáctico y el Común Sol.

language-Marish-name = Marish
language-Marish-description = Aunque los shadekin tienen una lengua basada en la empatía, aún hay tonos y sílabas sutiles, tan delicados como las emociones con las que los shadekin suelen comunicarse.

language-Machine-name = Lenguaje de audio codificado
language-Machine-description = Una lengua eficiente de tonos codificados desarrollada por sintéticos y cyborgs.

language-Bubblish-name = Burbujés
language-Bubblish-description = La lengua de los slimes. Es una mezcla de burbujeos y chasquidos. Muy difícil de hablar para los humanos sin ayuda mecánica.

language-Canilunzt-name = Canilunzt
language-Canilunzt-description = La lengua gutural que hablan y usan los habitantes del sistema Vazzend, compuesta de gruñidos, ladridos, aullidos cortos y mucho movimiento de orejas y cola. Los vulpkanin la hablan con facilidad.

language-Moffic-name = Moffic
language-Moffic-description = La lengua de la gente polilla roza lo completamente ininteligible.

language-Nekomimetic-name = Nekomimético
language-Nekomimetic-description = Para un observador casual, esta lengua es un lío incomprensible de japonés mal hablado. Para el felinoide, de alguna forma, es comprensible.

language-Draconic-name = Dracónico
language-Draconic-description = La lengua común de la gente lagarto, compuesta de siseos sibilantes y cascabeleos.

language-ScurretSign-name = Señas scurret
language-ScurretSign-description = ¡Wawa! ¡Las señas secretas que te permiten entender a tus compañeros scurret!

language-Ancestor-name = Ancestral
language-Ancestor-description = La protolengua usada principalmente por monos y simios.

language-Mouse-name = Ratón
language-Mouse-description = ¡Iiiiic!

language-Mothroach-name = Mothroach
language-Mothroach-description = ¡chirría!

language-Scratch-name = Scratch
language-Scratch-description = Un dialecto escrito y simplificado de los avali y los resomi. El Scratch es el modelo de lengua galáctica estándar de los Illuminate. Los orígenes de esta lengua provienen de las tribus nómadas anteriores a la era espacial, cuyas tallas y grabados en cuevas de hielo guardan un parecido notable con el Scratch moderno.

language-Terrum-name = Terrum
language-Terrum-description = Suena parecido al hebreo de la antigua Tierra.

language-Sylvan-name = Silvano
language-Sylvan-description = Las plantas hablan esta lengua.

language-Chittin-name = Chittin
language-Chittin-description = El ruido que hace al frotar sus quelíceros es en realidad una forma compleja de comunicación.
chat-speech-verb-chittin-1 = frota sus quelíceros
chat-speech-verb-chittin-2 = hace crujir sus quelíceros
chat-speech-verb-chittin-3 = sacude sus quelíceros
chat-chittin-whisper-wrap = [italic][BubbleHeader][Name]{$entityName}[/Name][/BubbleHeader] [BubbleContent]cruje sutilmente "[font="{$fontType}" size={$fontSize}][color={$color}]{$message}[/color][/font]"[/italic][/BubbleContent]

language-VoxPidgin-name = Vox-Pidgin
language-VoxPidgin-description = La lengua común de las distintas naves vox que forman el Cardumen. Para todos los demás suena como chillidos caóticos.

language-Zombie-name = Zombi
language-Zombie-description = Cerebrosss... Cerebrooosss..

language-CodeSpeak-name = CodeSpeak
language-CodeSpeak-description = Los operativos del Syndicate pueden usar una serie de palabras clave para transmitir información compleja, mientras suenan como conceptos y bebidas al azar para cualquiera que escuche.

language-Carptongue-name = Lengua carpa
language-Carptongue-description = Varios sonidos de pescado que quizás tengan sentido para las carpas espaciales.

language-Xeno-name = Xeno
language-Xeno-description = La lengua común de los xenos.

language-Cat-name = Gato
language-Cat-description = Miau

language-CatFeral-name = Gato (salvaje)
language-CatFeral-description = Un dialecto felino menos refinado, que solo los gatos pueden interpretar.

language-Dog-name = Perro
language-Dog-description = ¡Guau!

language-DogFeral-name = Perro (salvaje)
language-DogFeral-description = Un dialecto canino menos refinado, que solo los perros pueden interpretar.

language-Fox-name = Zorro
language-Fox-description = ¡Yip!

language-Chicken-name = Gallina
language-Chicken-description = ¡Cocó!

language-Duck-name = Pato
language-Duck-description = ¡Cuac!

language-Pig-name = Cerdo
language-Pig-description = ¡Oink!

language-Bat-name = Murciélago
language-Bat-description = ¡Iic!

language-Thaveyan-name = Thaveyan
language-Thaveyan-description = Una lengua lírica y cantarina común entre los thaven, que a otros les recuerda el sonido de las olas.

language-Darktongue-name = Lengua oscura
language-Darktongue-description = Suena un poco como aclararse la garganta, o tal vez como cortarle la de otro.

language-Felyaic-name = Felyaic
language-Felyaic-description = Una forma más pesada de la lengua oscura, hablada por los detarii en lugares profundos y oscuros.

language-Grumbakul-name = Grumbakul
language-Grumbakul-description = Una lengua escueta y robusta, ideal para la bebida y la industria.

language-Classical-name = Clásico
language-Classical-description = Hace mucho tiempo, todos hablaban esta lengua. La mayoría la hablaba bastante mal.

language-Aielic-name = Aielic
language-Aielic-description = Supuestamente la lengua original de los aielithii; hoy solo la hablan los queli.

language-Lagomorphian-name = Laguine
language-Lagomorphian-description = Una lengua muy laríngea, desarrollada como lengua de integración para la estructura vocal distinta de los lagomorfos.

language-Cosmic-name = Murmullo astral
language-Cosmic-description = LOS TELONES DEBEN CAER

language-Abductor-name = Abductor
language-Abductor-description = ...

language-Nexus-name = Nexus
language-Nexus-description = Una conexión neuronal que les permite comunicarse con otros de su especie a través de una red tecnológica.

language-Changeling-name = Mente colmena
language-Changeling-description = ...

language-Dantalion-name = Siervo
language-Dantalion-description = ...

language-Empathy-name = Empatía
language-Empathy-description = ...

language-Carpmind-name = Mente colmena
language-Carpmind-description = Varias mentes de pescado.

language-Xenomind-name = Mente colmena
language-Xenomind-description = Varias mentes de xenos y terrors.

language-Squeakish-name = Chillón
language-Squeakish-description = La lengua de los rodentia, compuesta por una serie de gorjeos y chillidos.

language-Penguin-name = Pingüino
language-Penguin-description = ¡Cuac cuac!
