alert-level-announcement-sender = ¡Atención! ¡{$sender} declaró la alerta {$name}! {$announcement}

alert-level-omega = Omega
alert-level-omega-announcement = Las fluctuaciones en la Cicatriz Nula indican que esta estación está desfasada de su realidad estándar. Espero que lo que sea que hayan hecho haya valido la pena.
alert-level-omega-instructions = Reconsidera tus decisiones.

alert-level-theta = Theta
alert-level-theta-announcement = Heri vixisti, hodi mori meministi.
alert-level-theta-instructions = Recuerda que eres mortal.

alert-level-psi = Psi
alert-level-psi-announcement = Eviten a cualquier cyborg que no cumpla con las especificaciones de NanoTrasen. No vayan solos. No se rindan en silencio. Busquen a los jefes de departamento para recibir más instrucciones.
alert-level-psi-instructions = Evita a los cyborgs hostiles.

alert-level-orange = Naranja
alert-level-orange-announcement = Existe una amenaza estructural o atmosférica crítica en toda la estación y es poco probable que se recupere. Se recomienda al personal de Ingeniería minimizar los peligros y asegurar el muelle de evacuación. Se recomienda a la tripulación mantenerse alejada de las zonas peligrosas y prepararse para una probable evacuación.
alert-level-orange-instructions = Evita los peligros y prepárate para la evacuación.
