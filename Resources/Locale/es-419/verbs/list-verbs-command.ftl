### Textos usados por el comando para listar verbos.
# Sobre todo mensajes de ayuda y de error.

list-verbs-command-description = Lista todos los verbos que un jugador puede usar sobre una entidad dada.
list-verbs-command-help = listverbs <uidJugador | "self"> <uidObjetivo>

list-verbs-command-invalid-args = listverbs requiere 2 argumentos.

list-verbs-command-invalid-player-uid = No se pudo interpretar el uid del jugador, o no se pasó "self".
list-verbs-command-invalid-target-uid = No se pudo interpretar el uid del objetivo.

list-verbs-command-invalid-player-entity = El uid de jugador indicado no corresponde a una entidad válida.
list-verbs-command-invalid-target-entity = El uid de objetivo indicado no corresponde a una entidad válida.

list-verbs-verb-listing = { $type }: { $verb }
