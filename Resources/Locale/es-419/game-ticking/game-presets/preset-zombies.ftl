zombie-title = Zombis
zombie-description = ¡Los no muertos se desataron en la estación! Trabaja con la tripulación para sobrevivir al brote y asegurar la estación.

zombieteors-title = Zombiteoros
zombieteors-description = ¡Los no muertos se desataron en la estación en medio de una lluvia de meteoros cataclísmica! ¡Trabaja con tus compañeros de tripulación y haz lo posible por sobrevivir!

zombie-not-enough-ready-players = ¡No hay suficientes jugadores listos para la partida! Había {$readyPlayersCount} jugadores listos de {$minimumPlayers} necesarios. No se puede iniciar Zombis.
zombie-no-one-ready = ¡Ningún jugador está listo! No se puede iniciar Zombis.

zombie-patientzero-role-greeting = Eres uno de los infectados iniciales. Consigue suministros y prepárate para tu inevitable transformación. Tu objetivo es tomar la estación infectando a tanta gente como sea posible.
zombie-healing = Sientes un hormigueo en la carne
zombie-infection-warning = Sientes que el virus zombi se apodera de ti
zombie-infection-underway = Tu sangre empieza a espesarse

zombie-alone = Te sientes completamente solo.

zombie-shuttle-call = Detectamos que los no muertos tomaron la estación. Enviamos un shuttle de emergencia para recoger al personal restante.

zombie-round-end-initial-count = {$initialCount ->
    [one] Hubo un infectado inicial:
    *[other] Hubo {$initialCount} infectados iniciales:
}
zombie-round-end-user-was-initial = - [color=plum]{$name}[/color] ([color=gray]{$username}[/color]) fue uno de los infectados iniciales.

zombie-round-end-amount-none = [color=green]¡Todos los zombis fueron erradicados![/color]
zombie-round-end-amount-low = [color=green]Casi todos los zombis fueron exterminados.[/color]
zombie-round-end-amount-medium = [color=yellow]El {$percent}% de la tripulación se convirtió en zombi.[/color]
zombie-round-end-amount-high = [color=crimson]El {$percent}% de la tripulación se convirtió en zombi.[/color]
zombie-round-end-amount-all = [color=darkred]¡Toda la tripulación se convirtió en zombi![/color]

zombie-round-end-survivor-count = {$count ->
    [one] Solo quedó un sobreviviente:
    *[other] Solo quedaron {$count} sobrevivientes:
}
zombie-round-end-user-was-survivor = - [color=White]{$name}[/color] ([color=gray]{$username}[/color]) sobrevivió al brote.
