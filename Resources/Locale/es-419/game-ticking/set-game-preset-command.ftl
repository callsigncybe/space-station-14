set-game-preset-command-description = Establece el preset de juego para la cantidad indicada de próximas rondas. También puede mostrar el título y la descripción de otro preset en el lobby para engañar a los jugadores.
set-game-preset-command-help-text = setgamepreset <id> [cantidad de rondas, por defecto 1] [preset señuelo]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [cantidad de rondas]
set-game-preset-command-hint-3 = [preset señuelo]

set-game-preset-optional-argument-not-integer = Si se indica el argumento 2, debe ser un número.
set-game-preset-preset-error = No se encontró el preset de juego "{$preset}"
set-game-preset-decoy-error = Si se indica el argumento 3, debe ser un preset válido. No se encontró el preset de juego "{$preset}"

#set-game-preset-preset-set = Preset de juego establecido en "{$preset}"
set-game-preset-preset-set-finite = Preset de juego establecido en "{$preset}" para las próximas {$rounds} rondas.
set-game-preset-preset-set-finite-with-decoy = Preset de juego establecido en "{$preset}" para las próximas {$rounds} rondas, mostrando {$decoy} en el lobby.
