### Componente de escondite secreto. Cosas como plantas en maceta, cojines de sillones cómodos, etc...

comp-secret-stash-action-hide-success = Escondes { THE($item) } en {$stashname}.
comp-secret-stash-action-hide-container-not-empty = ¿¡Ya hay algo aquí adentro!?
comp-secret-stash-action-hide-item-too-big = { CAPITALIZE(THE($item)) } es demasiado grande para caber en {$stashname}.
comp-secret-stash-action-get-item-found-something = ¡Había algo escondido en {$stashname}!
comp-secret-stash-on-examine-found-hidden-item = ¡Hay algo escondido en {$stashname}!
comp-secret-stash-on-destroyed-popup = ¡Se cae algo que estaba escondido en {$stashname}!

### Verbos
comp-secret-stash-verb-insert-into-stash = Esconder objeto
comp-secret-stash-verb-insert-message-item-already-inside = Ya hay un objeto escondido en {$stashname}.
comp-secret-stash-verb-insert-message-no-item = Esconder { THE($item) } en {$stashname}.
comp-secret-stash-verb-take-out-item = Agarrar objeto
comp-secret-stash-verb-take-out-message-something = Sacar lo que hay en {$stashname}.
comp-secret-stash-verb-take-out-message-nothing = No hay nada en {$stashname}.

comp-secret-stash-verb-close = Cerrar
comp-secret-stash-verb-cant-close = No puedes cerrar {$stashname} con eso.
comp-secret-stash-verb-open = Abrir

