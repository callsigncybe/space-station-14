alert-level-announcement = ¡Atención! ¡El nivel de alerta de la estación ahora es {$name}! {$announcement}

alert-level-unknown = Desconocido.
alert-level-unknown-instructions = Desconocido.

alert-level-green = Verde
alert-level-green-announcement = Ya es seguro volver a sus lugares de trabajo.
alert-level-green-instructions = Haz tu trabajo.

alert-level-blue = Azul
alert-level-blue-announcement = Puede haber una amenaza a bordo de la estación que pone en peligro a una minoría de la tripulación. Seguridad debe realizar controles al azar. Se recomienda a la tripulación mantenerse alerta y reportar actividad sospechosa a Seguridad.
alert-level-blue-instructions = Se recomienda a la tripulación mantenerse alerta y reportar actividad sospechosa a Seguridad.

alert-level-red = Rojo
alert-level-red-announcement = Hay una amenaza a bordo de la estación que pone en peligro a toda la tripulación. Seguridad debe prepararse para usar fuerza letal si es necesario. La tripulación debe buscar un lugar seguro donde refugiarse y se recomienda seguir a las autoridades presentes.
alert-level-red-instructions = La tripulación debe buscar un lugar seguro donde refugiarse y se recomienda seguir a las autoridades presentes.

# Starlight - start
alert-level-violet = Violeta
alert-level-violet-announcement = El mando de la estación confirmó un brote en toda la estación. Busquen a los jefes de departamento para recibir más instrucciones. Todo el personal debe contener el brote.
alert-level-violet-instructions = Todo el personal debe contener el brote.
# alert-level-violet-announcement = There is a viral threat on the station. Medical staff are advised to isolate crewmembers with any symptoms. Crewmembers are advised to distance themselves from others and perform safety measures to prevent further spread.
# alert-level-violet-instructions = Crewmembers are advised to distance themselves from others and perform safety measures to prevent further spread.
# Starlight - End

alert-level-yellow = Amarillo
alert-level-yellow-announcement = Hay una amenaza estructural o atmosférica localizada dentro de la estación. Se recomienda al personal de Ingeniería responder de inmediato y tomar medidas de seguridad. Se recomienda a la tripulación mantenerse alejada de la amenaza y quedarse en sus lugares de trabajo si es necesario.
alert-level-yellow-instructions = Se recomienda a la tripulación mantenerse alejada de la amenaza y quedarse en sus lugares de trabajo si es necesario.

alert-level-gamma = Gamma
alert-level-gamma-announcement = El Comando Central ordenó el nivel de seguridad Gamma en la estación. Seguridad debe llevar armas equipadas en todo momento, y todos los civiles deben buscar de inmediato al jefe más cercano para ser trasladados a un lugar seguro.
alert-level-gamma-instructions = Todos los civiles deben buscar de inmediato al jefe más cercano para ser trasladados a un lugar seguro.

alert-level-delta = Delta
alert-level-delta-announcement = La estación está bajo amenaza de destrucción inminente. Se recomienda a la tripulación escuchar a los jefes de departamento para obtener más información.
alert-level-delta-instructions = Se recomienda a la tripulación escuchar a los jefes de departamento para obtener más información.

alert-level-epsilon = Épsilon
alert-level-epsilon-announcement = El Comando Central ordenó el nivel de seguridad Épsilon en la estación. Consideren rescindidos todos los contratos.
alert-level-epsilon-instructions = Consideren rescindidos todos los contratos.
