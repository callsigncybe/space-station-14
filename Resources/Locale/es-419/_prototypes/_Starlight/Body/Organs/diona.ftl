ent-OrganDionaBrain = cerebro de diona
    .desc = El centro de la actividad pseudoneurológica de una diona; sus zarcillos parecidos a raíces buscan su antiguo cuerpo.
    .suffix = Diona
ent-OrganDionaBrainNymph = cerebro de ninfa diona
    .desc = La fuente de una inteligencia increíble e interminable. Honk.
    .suffix = Ninfa diona
ent-OrganDionaEyes = ojos de diona
    .desc = ¡Te veo!
    .suffix = Diona
ent-OrganDionaLungs = pulmones de diona
    .desc = Una masa esponjosa de estructuras viscosas parecidas a hojas. Puede respirar tanto dióxido de carbono como oxígeno.
    .suffix = Diona
ent-OrganDionaLungsNymph = pulmones de ninfa diona
    .desc = Filtran el oxígeno de una atmósfera, que luego se envía al torrente sanguíneo para usarse como transportador de electrones.
    .suffix = Ninfa diona
ent-OrganDionaNymphBrain = ninfa diona
    .desc = Contiene el cerebro de lo que fue una Diona completamente formada. Matarla mataría a la Diona para siempre. Monstruo.
    .suffix = Ninfa diona
ent-OrganDionaNymphLungs = pulmones de ninfa diona
    .desc = Contiene los pulmones de lo que fue una Diona completamente formada. Te deja sin aliento.
    .suffix = Ninfa diona
ent-OrganDionaNymphStomach = estómago de ninfa diona
    .desc = Contiene el estómago de lo que fue una Diona completamente formada. No por eso sabe mejor.
    .suffix = Ninfa diona
ent-OrganDionaStomach = estómago de diona
    .desc = El equivalente de un estómago en las dionas; apesta a espárragos y vinagre.
    .suffix = Diona
ent-OrganDionaStomachNymph = estómago de ninfa diona
    .desc = Qué asco. Esto es difícil de digerir.
    .suffix = Ninfa diona
ent-OrganDionaTongue = lengua
    .desc = Un músculo carnoso que se usa principalmente para mentir.
    .suffix = Diona
