ent-WeaponMechCombatAMLG90 = AMLG-90 "Reaver"
    .desc = Una ametralladora láser de ráfagas potente y avanzada, diseñada para la máxima potencia de fuego.
    .suffix = Arma de mech, Arma, Combate, Láser
ent-WeaponMechCombatDisabler = inmovilizador CH-PD
    .desc = Un arma aturdidora montada no letal que te permite inmovilizar a los intrusos.
    .suffix = Arma de mech, Arma, Combate, Inmovilizador
ent-WeaponMechCombatFiredartLaser = láser CH-PS "Firedart"
    .desc = El armamento de combate estándar de los mechs es un láser de combate montado.
    .suffix = Arma de mech, Arma, Combate, Láser
ent-WeaponMechCombatFlashbangLauncher = lanzador de granadas cegadoras SGL-6
    .desc = Un lanzagranadas rotativo capaz de fabricar y lanzar cargas cegadoras contra multitudes revoltosas.
    .suffix = Arma de mech, Arma, Combate, Cegadora
ent-WeaponMechCombatImmolationGun = arma de haz de inmolación ZFI
    .desc = Un arma para mechs de batalla que dispara haces de alta temperatura.
    .suffix = Arma de mech, Arma, Combate, Láser
ent-WeaponMechCombatIon = cañón pesado de iones Mk.IV
    .desc = Un arma de iones montada que funciona con el mismo principio que una carabina de iones de mano. Extremadamente eficaz contra sintéticos, robots y otros mechs.
    .suffix = Arma de mech, Arma, Combate, Iones
ent-WeaponMechCombatMissileRack6 = lanzamisiles BRM-6
    .desc = Un conjunto de misiles pesados diseñado para desatar una auténtica carnicería sobre tus enemigos.
    .suffix = Arma de mech, Arma, Combate, Misil
ent-WeaponMechCombatMissileRack8 = lanzamisiles ligero SRM-8
    .desc = Lanza misiles de baja potencia explosiva. Relativamente débiles, pero capaces de suprimir posiciones enemigas.
    .suffix = Arma de mech, Arma, Combate, Misil ligero
ent-WeaponMechCombatPulseRifle = rifle de pulsos pesado eZ-14 mk2
    .desc = Dispara un láser de pulsos pesado.
    .suffix = Arma de mech, Arma, Combate, Pulsos
ent-WeaponMechCombatShotgun = LBX AC 10 "Scattershot"
    .desc = Una escopeta montada capaz de despachar objetivos rápidamente en combate cuerpo a cuerpo.
    .suffix = Arma de mech, Arma, Combate, Escopeta
ent-WeaponMechCombatShotgunIncendiary = carabina FNX-99 "Hades"
    .desc = Escopeta montada, adaptada para disparar munición incendiaria.
    .suffix = Arma de mech, Arma, Combate, Escopeta, Incendiaria
ent-WeaponMechCombatSolarisLaser = cañón láser CH-LC "Solaris"
    .desc = Un cañón láser de combate montado experimental que causa más daño, pero también tiene un tiempo de recarga mayor que el "Firedart".
    .suffix = Arma de mech, Arma, Combate, Láser
ent-WeaponMechCombatTaser = táser montado PBT "Pacifier"
    .desc = Un táser montado no letal que te permite aturdir a los intrusos.
    .suffix = Arma de mech, Arma, Combate, Inmovilizador, admeme
ent-WeaponMechCombatTeslaCannon = cañón Tesla P-X
    .desc = Un arma para mechs de combate que dispara bolas de energía, basada en el principio de un motor Tesla experimental.
    .suffix = Arma de mech, Arma, Combate, Tesla
ent-WeaponMechCombatUltraAC54 = cañón rotativo ULTRA AC54 'Hotchkiss'
    .desc = Un cañón automático rotativo avanzado que dispara balas FMJ. Solo para admins.
    .suffix = Arma de mech, Arma, Combate, Solo admins
ent-WeaponMechCombatUltraRifle = Ultra AC-2
    .desc = Un rifle de ráfagas barato y confiable.
    .suffix = Arma de mech, Arma, Combate, Rifle
ent-WeaponMechCombatXray = proyector de rayos X S-1
    .desc = Arma de mech experimental que dispara rayos X, causando quemaduras por radiación superficiales y profundas.
    .suffix = Arma de mech, Arma, Combate, Rayos X
ent-WeaponMechSniperMime = carabina S.H.H. "Quietus"
    .desc = Un invento de los mimos; las pruebas de campo demostraron que los objetivos ni siquiera pueden gritar antes de caer.
    .suffix = Mech, Arma, Combate, Francotirador
